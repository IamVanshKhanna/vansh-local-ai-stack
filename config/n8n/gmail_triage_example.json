{
  "name": "Gmail Triage",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute",
              "minute": 30
            }
          ]
        },
        "filters": {
          "labelFilter": ["UNREAD"]
        }
      },
      "id": "gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => ({\n  json: {\n    subject: item.json.subject || '',\n    sender: item.json.from || '',\n    body: item.json.text || '',\n    date: item.json.date || ''\n  }\n}));"
      },
      "id": "extract-email",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ model: 'llama3.2', prompt: `Categorise this email into exactly one of: urgent, reply-today, low-priority, newsletter.\\n\\nSubject: ${$json.subject}\\nFrom: ${$json.sender}\\nBody: ${$json.body.substring(0, 500)}\\n\\nCategory:`, stream: false, options: { num_predict: 10 } }) }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ollama-classify",
      "name": "Classify via Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.response }}",
              "operation": "contains",
              "value2": "urgent"
            }
          ]
        }
      },
      "id": "check-urgent",
      "name": "Is Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [910, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst summary = items.map(item => \n  `- [${item.json.category || 'unknown'}] ${item.json.subject} (from: ${item.json.sender})`\n).join('\\n');\n\nconst output = `# Email Triage - ${new Date().toISOString().split('T')[0]}\\n\\n${summary}\\n`;\n\nreturn [{ json: { summary: output } }];"
      },
      "id": "build-summary",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1130, 400]
    },
    {
      "parameters": {
        "fileName": "/home/user/mail/daily_summary.md",
        "operation": "append"
      },
      "id": "write-summary",
      "name": "Write Summary File",
      "type": "n8n-nodes-base.writeFile",
      "typeVersion": 1,
      "position": [1350, 400]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Extract Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Fields": {
      "main": [
        [
          {
            "node": "Classify via Ollama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify via Ollama": {
      "main": [
        [
          {
            "node": "Is Urgent?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Urgent?": {
      "main": [
        [
          {
            "node": "Build Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Summary": {
      "main": [
        [
          {
            "node": "Write Summary File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
