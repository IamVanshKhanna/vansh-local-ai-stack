# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_CODE_MODEL=deepseek-coder-v2:lite
OLLAMA_EMBED_MODEL=nomic-embed-text

# Data Directories
LOG_DIR=~/.local-ai-stack/logs
REPORT_DIR=~/.local-ai-stack/reports
CATALOG_DIR=~/.local-ai-stack/catalogs
BACKUP_DIR=~/.local-ai-stack/backups

# Notifications (optional — leave empty to disable)
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_TO=

# Feature Flags
PREFER_LOCAL=true
DRY_RUN=false
