# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# Ollama Configuration
# ============================================

# Ollama API endpoint
OLLAMA_HOST=http://localhost:11434

# Default model for general queries
OLLAMA_DEFAULT_MODEL=llama3.2

# Model for code completion
OLLAMA_CODE_MODEL=deepseek-coder-v2:lite

# Model for embeddings (RAG)
OLLAMA_EMBED_MODEL=nomic-embed-text


# ============================================
# Python Script Settings
# ============================================

# Directory for script logs
LOG_DIR=~/.local-ai-stack/logs

# Directory for reports
REPORT_DIR=~/.local-ai-stack/reports

# Directory for file catalogs
CATALOG_DIR=~/.local-ai-stack/catalogs

# Directory for backup metadata
BACKUP_DIR=~/.local-ai-stack/backups


# ============================================
# RAG / Vector Database (Phase 2)
# ============================================

# Vector database type (chromadb, qdrant)
VECTOR_DB_TYPE=chromadb

# Vector database path
VECTOR_DB_PATH=~/.local-ai-stack/vector-db

# Chunk size for document splitting (tokens)
CHUNK_SIZE=512

# Chunk overlap (tokens)
CHUNK_OVERLAP=50


# ============================================
# Email Notifications (Optional)
# ============================================

# SMTP server for email notifications
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_TO=recipient@example.com


# ============================================
# Webhook Notifications (Optional)
# ============================================

# Webhook URL for notifications (Slack, Discord, etc.)
# WEBHOOK_URL=https://hooks.slack.com/services/...


# ============================================
# Cloud Fallback (Optional)
# ============================================

# OpenAI API key for fallback
# OPENAI_API_KEY=sk-...

# Anthropic API key for fallback
# ANTHROPIC_API_KEY=sk-ant-...


# ============================================
# n8n Integration (Phase 4)
# ============================================

# n8n webhook URL
# N8N_WEBHOOK_URL=http://localhost:5678/webhook

# n8n API key
# N8N_API_KEY=...


# ============================================
# Sync and Remote Access (Optional)
# ============================================

# Syncthing API key for sync
# SYNCTHING_API_KEY=...

# Tailscale auth key
# TAILSCALE_AUTHKEY=...


# ============================================
# Feature Flags
# ============================================

# Prefer local inference over cloud (true/false)
PREFER_LOCAL=true

# Enable verbose logging (true/false)
VERBOSE_LOGGING=false

# Dry run mode for file operations (true/false)
DRY_RUN=false
